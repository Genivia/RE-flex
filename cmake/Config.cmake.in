# CMake expands this marker into helpers that make the installed package
# relocatable and provide check_required_components().
@PACKAGE_INIT@

# Load the imported Reflex:: targets generated by the project's install(EXPORT).
include("${CMAKE_CURRENT_LIST_DIR}/ReflexTargets.cmake")

